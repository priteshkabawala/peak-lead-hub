NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RESEND_API_KEY=re_your-resend-api-key-here
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
# Your Calendly scheduling link, e.g. https://calendly.com/your-team/intro-call
NEXT_PUBLIC_CALENDLY_URL=

# ── WhatsApp (new-lead confirmation) ──────────────────────────────────────────
# Choose ONE provider: "twilio" or "meta". Leave blank to disable WhatsApp.
WHATSAPP_PROVIDER=

# Option A — Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=            # your WhatsApp sender, e.g. +447xxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_SID=    # approved Content template SID (HX...)

# Option B — Meta WhatsApp Cloud API
WHATSAPP_META_TOKEN=             # permanent access token
WHATSAPP_META_PHONE_NUMBER_ID=   # phone number ID from Meta
WHATSAPP_META_TEMPLATE_NAME=     # approved template name
WHATSAPP_META_LANG=en_GB         # template language code

# ── LinkedIn Lead Sync ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Space-separated scopes exactly as granted in the LinkedIn Developer Portal
# (Auth tab). Below reflects Advertising API access only — Lead Sync is a
# SEPARATE approval; add its scope here once granted (leadFormResponses
# calls 403 until then).
LINKEDIN_SCOPES=r_ads rw_ads r_ads_reporting r_organization_social r_organization_admin rw_organization_admin r_basicprofile
# API version in YYYYMM format, see https://learn.microsoft.com/en-us/linkedin/marketing/versioning
LINKEDIN_API_VERSION=202601

# Random secret Vercel Cron sends as a Bearer token to trigger LinkedIn sync.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Shared secret for the LeadsBridge (or Zapier/Make) webhook that relays
# LinkedIn leads to /api/linkedin/webhook, used until our own Lead Sync API
# access is approved. Generate with: openssl rand -hex 24
LINKEDIN_WEBHOOK_SECRET=
