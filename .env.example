NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RESEND_API_KEY=re_your-resend-api-key-here
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
# Your Calendly scheduling link, e.g. https://calendly.com/your-team/intro-call
NEXT_PUBLIC_CALENDLY_URL=

# ── WhatsApp (new-lead confirmation) ──────────────────────────────────────────
# Choose ONE provider: "twilio" or "meta". Leave blank to disable WhatsApp.
WHATSAPP_PROVIDER=

# Option A — Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=            # your WhatsApp sender, e.g. +447xxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_SID=    # approved Content template SID (HX...)

# Option B — Meta WhatsApp Cloud API
WHATSAPP_META_TOKEN=             # permanent access token
WHATSAPP_META_PHONE_NUMBER_ID=   # phone number ID from Meta
WHATSAPP_META_TEMPLATE_NAME=     # approved template name
WHATSAPP_META_LANG=en_GB         # template language code
